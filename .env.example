# WardSetu backend environment — placeholders only. Copy to `.env` and fill in.
# Never commit `.env` or real secrets.

NODE_ENV=development

# Must remain 127.0.0.1:2010 (enforced at startup)
HOST=127.0.0.1
PORT=2010

API_PREFIX=api

# Production DB is server-only. For local development point this at a separate
# database such as `wardsetu_dev` — never at production.
DATABASE_URL=postgresql://warduser:CHANGE_ME@127.0.0.1:5432/wardsetu

JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins. Never use `*` in production.
CORS_ORIGINS=https://wardsetu.in,https://www.wardsetu.in,http://localhost:3000,http://localhost:5173

SWAGGER_ENABLED=true

# error | warn | info | debug
LOG_LEVEL=info

# Maximum JSON / urlencoded request body size
REQUEST_BODY_LIMIT=1mb
